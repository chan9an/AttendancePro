<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AttendanceManagement.Services.Identity.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AttendanceManagement.Services.Identity.Domain\AttendanceManagement.Services.Identity.Domain.csproj" />
    <ProjectReference Include="..\AttendanceManagement.Services.Identity.Application\AttendanceManagement.Services.Identity.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core 8 and SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.4" />
    <!-- ASP.NET Core Identity EF Core integration -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.4" />
    <!-- Microsoft Extensions for Dependency Injection & Options -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

</Project>
